[Unit]
Description=Tasmi Transcription Server
After=network.target

[Service]
Type=simple
User=tasmi
WorkingDirectory=/opt/tasmi
EnvironmentFile=/opt/tasmi/.env
Environment=OMP_NUM_THREADS=2
Environment=HF_HOME=/opt/tasmi/.cache/huggingface
ExecStart=/opt/tasmi/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --ws-max-size 65536 --ws-ping-interval 20 --ws-ping-timeout 20
Restart=always
RestartSec=5
UMask=0077

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/tasmi /tmp
PrivateTmp=true
PrivateDevices=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
