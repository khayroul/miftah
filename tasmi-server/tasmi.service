[Unit]
Description=Tasmi Transcription Server
After=network.target

[Service]
Type=simple
User=tasmi
WorkingDirectory=/opt/tasmi
EnvironmentFile=/opt/tasmi/.env
ExecStart=/opt/tasmi/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/tasmi /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
