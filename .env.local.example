# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mushaf CDN (Gate B)
MUSHAF_CDN_ENABLED=false
MUSHAF_PAGES_BUCKET=mushaf-pages
MUSHAF_MANIFESTS_BUCKET=mushaf-manifests
# Optional words bucket/base URL for Theme-view glyph images.
# If omitted, app uses local assets/words and falls back to text when unavailable.
# MUSHAF_WORDS_BUCKET=mushaf-words
# Optional explicit overrides (otherwise derived from NEXT_PUBLIC_SUPABASE_URL + bucket names)
# MUSHAF_PAGES_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/mushaf-pages
# MUSHAF_MANIFESTS_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/mushaf-manifests
# MUSHAF_WORDS_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/mushaf-words

# Single-user hardcoded UUID (until auth is added)
MIFTAH_USER_ID=00000000-0000-0000-0000-000000000001

# Tasmi transcription proxy
# These stay server-side. The browser uses the authenticated Next.js routes;
# streaming receives only a short-lived, single-use ticket for the direct WSS.
# TASMI_SERVER_URL=http://127.0.0.1:8000
# TASMI_API_KEY=your-tasmi-api-key
# Optional; derived from TASMI_SERVER_URL when omitted.
# TASMI_STREAM_URL=ws://127.0.0.1:8000/ws/transcribe

# OpenAI (for translation batch only — Gate A)
OPENAI_API_KEY=sk-...

# Telegram bot (RETIRED for v1 — see src/bot/RETIRED.md; parked, not deleted)
# TELEGRAM_BOT_TOKEN: required for the bot to start at all; without it the bot
#   process exits immediately (it does NOT run un-tokened).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS: comma-separated allowlist of Telegram chat ids.
#   As of RF-1 this fails CLOSED — if unset/empty the bot REFUSES ALL traffic
#   (previously it failed OPEN and let everyone through in "dev mode").
TELEGRAM_ALLOWED_CHAT_IDS=

# Rate limiting (Upstash Redis) — used by src/lib/ratelimit.ts.
# FAILS OPEN: if EITHER of these is unset, rate limiting is DISABLED and every
#   request is allowed (checkRateLimit returns success). Set both in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
