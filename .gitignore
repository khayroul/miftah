# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.local.example

# vercel
.vercel

# Miftah assets (large binaries — stored in Supabase Storage / CDN)
/assets/pages/*.png
/assets/ayat/*.png
/assets/words/*.png
!/assets/**/.gitkeep

# QCF fonts (604 TTF files per version, ~94MB each — download via script)
/assets/fonts/qcf-v2/*.TTF
/assets/fonts/qcf-v2-woff2/

# Test renders (proof-of-concept output)
/test/qcf_*.png

# Large data files (QUL dump, zips)
data/qul/mini_quran_dev.sql
data/qul/*.zip
data/qul/indonesian-word-by-word-translation.json.zip

# External line-break data (clone from zonetecde/mushaf-layout)
data/mushaf-layout/

# Python cache
__pycache__/
*.pyc

# Seed split files (generated, keep only seed.sql)
data/seed/seed_part*.sql

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/
