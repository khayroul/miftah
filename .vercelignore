# Ignore large local artifacts not needed at runtime on Vercel
# NOTE: directory names WITHOUT a leading slash match at EVERY depth
# (gitignore semantics). An unanchored `supabase/` silently stripped
# src/data/supabase (the whole DB client layer) from the 2026-07-15 build.
# Root-only ignores MUST be anchored with a leading slash.
assets/ayat/
assets/pages/
assets/words/
assets/manifests/
assets/fonts/qcf-v2/
assets/fonts/qcf-v2-woff2/
/test/
.tmp/
node_modules/
.next/
coverage/

# Ignore heavy data folders, keep only lightweight runtime fallbacks
data/*
!data/theme_chunk_overrides.json
!data/bm_wbw_complete.json
!data/qul/
!data/seed/
!data/mushaf-layout/

data/seed/*
!data/seed/ayat.json
!data/seed/surahs.json

data/qul/*
!data/qul/english-wbw-translation.json

# Dev/ops artifacts (keep prebuild scripts for Vercel build)
# NOTE: prebuild = generate-surah-map + split-translations + copy-layouts +
# render-pwa-artifacts (which reads sw.template.js). Every file that chain
# touches MUST be allowlisted here, or the Vercel build fails with
# ERR_MODULE_NOT_FOUND (exactly what broke the 2026-07-14 deploy).
scripts/*
!scripts/generate-surah-map.ts
!scripts/split-translations.ts
!scripts/copy-layouts.ts
!scripts/render-pwa-artifacts.ts
!scripts/sw.template.js
!scripts/generate-pwa-config.ts
/supabase/
/ops/
/n8n-exports/
/manifests/
