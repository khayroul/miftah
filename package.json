{
  "name": "miftah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild:surah-map": "tsx scripts/generate-surah-map.ts",
    "prebuild:translations": "tsx scripts/split-translations.ts",
    "prebuild:layouts": "tsx scripts/copy-layouts.ts",
    "prebuild:pwa-config": "tsx scripts/generate-pwa-config.ts",
    "prebuild:inject-build-id": "tsx scripts/inject-build-id.ts",
    "prebuild": "npm run prebuild:surah-map && npm run prebuild:translations && npm run prebuild:layouts && npm run prebuild:pwa-config && npm run prebuild:inject-build-id",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "perf:e2e-speed": "node scripts/perf/e2e-speed.mjs",
    "perf:read-chunks": "node scripts/perf/assert-read-initial-chunks.mjs",
    "test:pwa": "node --import tsx --test src/shared/pwa/surahPageMap.test.ts src/shared/pwa/offlineTranslations.test.ts src/shared/pwa/mushafStatus.test.ts src/shared/pwa/downloadEngine.test.ts src/shared/pwa/downloadMigration.test.ts src/shared/pwa/offlinePageData.test.ts scripts/mushaf-cdn-version.test.ts",
    "test:read-nav": "tsx --test src/features/read/domain/readNavigationUtils.test.ts",
    "test:read-mode": "tsx --test src/features/read/domain/readMode.test.ts",
    "test:reading-progress": "tsx --test src/features/read/domain/readingProgressStorage.test.ts",
    "test:mushaf-view": "tsx --test src/lib/mushafViewState.test.ts",
    "test:page-audio": "tsx --test src/features/read/domain/audio/pageAudioTracks.test.ts",
    "test:hifz-tasmi": "vitest run src/features/hifz/domain/page-words.test.ts src/features/hifz/domain/progressive-unveil.test.ts src/features/hifz/domain/tebuk.test.ts src/features/tasmi/domain/arabic-normalizer.test.ts src/features/tasmi/domain/sequence-matcher.test.ts src/features/tasmi/domain/talqin-player.test.ts src/features/tasmi/domain/tasmi-session.test.ts",
    "render:import-official": "python3 scripts/render/import_official_pages.py",
    "render:check-ios-parity": "python3 scripts/render/check_ios_parity.py",
    "render:extract-official-subassets": "python3 scripts/render/extract_official_subassets.py",
    "render:check-official-completeness": "python3 scripts/render/check_official_completeness.py",
    "render:upload-cdn": "tsx scripts/render/upload_supabase_assets.ts",
    "qa:mobile-tap": "node scripts/render/mobile_tap_qa.mjs",
    "seed:fetch-ayah-themes": "python3 scripts/seed/fetch_qul_ayah_theme_chunks.py",
    "seed:translate-ayah-themes-bm": "tsx scripts/seed/translate_ayah_theme_chunks_bm.ts",
    "seed:sync-ayah-themes": "tsx scripts/seed/sync_ayah_theme_chunks.ts",
    "seed:check-word-coverage": "python3 scripts/seed/check_word_coverage.py",
    "seed:sync-word-coverage": "python3 scripts/seed/sync_word_coverage.py",
    "bot": "echo 'miftah bot is RETIRED for v1 (2026-07-13; see src/bot/RETIRED.md). Refusing to start.' && exit 1",
    "bot:dev": "echo 'miftah bot is RETIRED for v1 (2026-07-13; see src/bot/RETIRED.md). Refusing to start.' && exit 1",
    "bot:service:install": "echo 'miftah bot is RETIRED for v1 (2026-07-13; see src/bot/RETIRED.md). Refusing to install service.' && exit 1",
    "bot:service:start": "echo 'miftah bot is RETIRED for v1 (2026-07-13; see src/bot/RETIRED.md). Refusing to start service.' && exit 1",
    "bot:service:stop": "bash scripts/bot/stop_launchd.sh",
    "bot:service:status": "bash scripts/bot/status_launchd.sh",
    "bot:service:uninstall": "bash scripts/bot/uninstall_launchd.sh",
    "bot:service:logs": "bash scripts/bot/logs_launchd.sh",
    "symphony:setup": "bash scripts/symphony/setup_symphony.sh",
    "symphony:linear-check": "bash scripts/symphony/check_linear.sh",
    "symphony:run": "bash scripts/symphony/run_symphony.sh"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@sentry/nextjs": "^10.43.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "dotenv": "^17.3.1",
    "glob": "^13.0.6",
    "grammy": "^1.41.1",
    "next": "16.1.6",
    "node-fetch": "^2.7.0",
    "playwright": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "ts-fsrs": "^5.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
